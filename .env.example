# Flask runtime configuration for the Tic-Tac-Toe AI project.
# Copy this file to `.env` and fill in real values (or set them as
# environment variables before running the app).

# Random string used to sign Flask session cookies.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional overrides
HOST=127.0.0.1
PORT=5000
# FLASK_DEBUG=1